{
    "name": "thesis/monorepo",
    "description": "Thesis: an asynchronous PHP ecosystem",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "php-64bit": "*",
        "ext-filter": "*",
        "ext-openssl": "*",
        "ext-uri": "*",
        "internal/container": "^1.1",
        "psr/clock": "^1.0",
        "revolt/event-loop": "^1.0.9",
        "testo/testo": "^0.10.29"
    },
    "require-dev": {
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-simplexml": "*",
        "ext-sockets": "*",
        "amphp/amp": "^3",
        "composer/semver": "^3.4",
        "llm/skills": "^1.17",
        "symfony/console": "^8.0",
        "symfony/var-dumper": "^8.0",
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/lifecycle": "^0.1.9",
        "testo/test": "^0.1.8"
    },
    "replace": {
        "thesis/amqp": "self.version",
        "thesis/async": "self.version",
        "thesis/io": "self.version",
        "thesis/net": "self.version",
        "thesis/testo": "self.version",
        "thesis/time": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Amqp\\": "packages/amqp/src/",
            "Thesis\\Async\\": "packages/async/src/",
            "Thesis\\Io\\": "packages/io/src/",
            "Thesis\\Net\\": "packages/net/src/",
            "Thesis\\Testo\\": "packages/testo/src/",
            "Thesis\\Time\\": "packages/time/src/"
        },
        "files": [
            "packages/amqp/src/autoload.files.php",
            "packages/async/src/autoload.files.php",
            "packages/net/src/autoload.files.php",
            "packages/time/src/autoload.files.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Amqp\\": "packages/amqp/tests/",
            "Thesis\\Async\\": "packages/async/tests/",
            "Thesis\\Io\\": "packages/io/tests/",
            "Thesis\\Monorepo\\": "tools/monorepo/src/",
            "Thesis\\Monorepo\\Tests\\": "tools/monorepo/tests/",
            "Thesis\\Net\\": "packages/net/tests/",
            "Thesis\\PhpCsFixer\\Tests\\": "tools/php-cs-fixer/tests/",
            "Thesis\\Testo\\": "packages/testo/tests/",
            "Thesis\\Time\\": "packages/time/tests/"
        },
        "files": [
            "packages/amqp/tests/autoload.files.php",
            "packages/async/tests/autoload.files.php",
            "packages/net/tests/autoload.files.php",
            "packages/time/tests/autoload.files.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "llm/skills": true
        }
    }
}
