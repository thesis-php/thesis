{
    "name": "thesis/monorepo",
    "description": "Thesis: an asynchronous PHP ecosystem",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "php-64bit": "*",
        "ext-filter": "*",
        "ext-openssl": "*",
        "ext-uri": "*",
        "internal/container": "^1.1",
        "phpstan/phpstan": "^2.3",
        "psr/clock": "^1.0",
        "revolt/event-loop": "^1.0.9",
        "testo/testo": "^0.10.29"
    },
    "require-dev": {
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-simplexml": "*",
        "ext-sockets": "*",
        "ext-tokenizer": "*",
        "ext-zlib": "*",
        "amphp/amp": "^3",
        "composer/semver": "^3.4",
        "llm/skills": "^1.17",
        "symfony/console": "^8.0",
        "symfony/var-dumper": "^8.0",
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/lifecycle": "^0.1.9",
        "testo/test": "^0.1.8"
    },
    "replace": {
        "thesis/amqp": "2.0.x-dev",
        "thesis/async": "0.1.x-dev",
        "thesis/cache": "0.1.x-dev",
        "thesis/exceptionally": "0.4.x-dev",
        "thesis/formatter": "0.2.x-dev",
        "thesis/io": "0.1.x-dev",
        "thesis/net": "0.1.x-dev",
        "thesis/phpstan-extension": "0.1.x-dev",
        "thesis/testo-plugin": "0.1.x-dev",
        "thesis/time": "0.1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "packages/exceptionally/src/",
            "Thesis\\Amqp\\": "packages/amqp/src/",
            "Thesis\\Async\\": "packages/async/src/",
            "Thesis\\Cache\\": "packages/cache/src/",
            "Thesis\\Formatter\\": "packages/formatter/src/",
            "Thesis\\Io\\": "packages/io/src/",
            "Thesis\\Net\\": "packages/net/src/",
            "Thesis\\PhpstanExtension\\": "packages/phpstan-extension/src/",
            "Thesis\\TestoPlugin\\": "packages/testo-plugin/src/",
            "Thesis\\Time\\": "packages/time/src/"
        },
        "files": [
            "packages/amqp/src/Internal/Protocol/decodeMethod.php",
            "packages/amqp/src/Internal/Protocol/functions.php",
            "packages/amqp/src/Internal/functions.php",
            "packages/async/src/Internal/fiberKey.php",
            "packages/async/src/Internal/holding.php",
            "packages/async/src/Internal/some.php",
            "packages/async/src/VirtualTime/functions.php",
            "packages/async/src/functions.php",
            "packages/async/src/platform.php",
            "packages/exceptionally/src/functions.php",
            "packages/formatter/src/Internal/functions.php",
            "packages/formatter/src/functions.php",
            "packages/io/src/Internal/lastError.php",
            "packages/io/src/Internal/stdio.php",
            "packages/io/src/functions.php",
            "packages/net/src/Internal/functions.php",
            "packages/net/src/functions.php",
            "packages/time/src/Internal/functions.php",
            "packages/time/src/functions.php",
            "packages/time/src/polyfill.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "packages/exceptionally/tests/",
            "Thesis\\Amqp\\": "packages/amqp/tests/",
            "Thesis\\Async\\": "packages/async/tests/",
            "Thesis\\Cache\\": "packages/cache/tests/",
            "Thesis\\Formatter\\": "packages/formatter/tests/",
            "Thesis\\Io\\": "packages/io/tests/",
            "Thesis\\Monorepo\\": "tools/monorepo/src/",
            "Thesis\\Monorepo\\Tests\\": "tools/monorepo/tests/",
            "Thesis\\Net\\": "packages/net/tests/",
            "Thesis\\PhpCsFixer\\Tests\\": "tools/php-cs-fixer/tests/",
            "Thesis\\TestoPlugin\\": "packages/testo-plugin/tests/",
            "Thesis\\Time\\": "packages/time/tests/"
        },
        "files": [
            "packages/amqp/tests/functions.php",
            "packages/amqp/codegen/generate.php",
            "packages/async/tests/functions.php",
            "packages/cache/tests/functions.php",
            "packages/exceptionally/tests/functions.php",
            "packages/io/tests/functions.php",
            "packages/net/tests/functions.php",
            "packages/time/tests/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "llm/skills": true
        }
    }
}
