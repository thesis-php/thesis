{
    "name": "thesis/monorepo",
    "description": "Asynchronous PHP on an event loop of its own: structured concurrency for fibers, non-blocking I/O, TCP/TLS/DNS, HTTP/1, AMQP, PSR-3 logging, Unix processes, hot reload and a runnable demo. Monorepo of the thesis/* packages.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "php",
        "async",
        "asynchronous",
        "fibers",
        "event-loop",
        "structured-concurrency",
        "concurrency",
        "non-blocking-io",
        "monorepo",
        "amqp",
        "rabbitmq",
        "sockets",
        "dns",
        "http-server",
        "logging",
        "demo",
        "process",
        "hot-reload"
    ],
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.6",
        "php-64bit": "*",
        "ext-filter": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-uri": "*",
        "ext-zlib": "*",
        "composer-runtime-api": "^2.2",
        "internal/container": "^1.1",
        "phpstan/phpstan": "^2.3.6",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/polyfill-php84": "^1.34",
        "symfony/polyfill-php85": "^1.32",
        "testo/testo": "^0.10.60"
    },
    "require-dev": {
        "ext-intl": "*",
        "ext-posix": "*",
        "ext-simplexml": "*",
        "ext-sockets": "*",
        "ext-tokenizer": "*",
        "amphp/http-client": "^5.3",
        "amphp/http-server": "^3.4",
        "amphp/process": "^2.1",
        "composer/semver": "^3.4",
        "ergebnis/composer-normalize": "^2.57",
        "friendsofphp/php-cs-fixer": "^3.95.30",
        "infection/infection": "^0.35.10",
        "llm/skills": "^1.17",
        "monolog/monolog": "^3.0",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "phpstan/tally": "^1.0.2",
        "rector/rector": "^2.8.5",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symfony/console": "^8.0",
        "symfony/process": "^8.1",
        "symfony/var-dumper": "^8.0",
        "testo/assert": "^0.1.17",
        "testo/bridge-infection": "^0.1.9",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/lifecycle": "^0.1.9",
        "testo/test": "^0.1.8"
    },
    "replace": {
        "thesis/amqp": "2.0.x-dev",
        "thesis/async": "0.1.x-dev",
        "thesis/async-trace": "0.1.x-dev",
        "thesis/cache": "0.1.x-dev",
        "thesis/demo": "0.1.x-dev",
        "thesis/dispatcher": "0.4.x-dev",
        "thesis/exceptionally": "0.4.x-dev",
        "thesis/formatter": "0.2.x-dev",
        "thesis/hot-reload": "0.5.x-dev",
        "thesis/http": "0.1.x-dev",
        "thesis/io": "0.1.x-dev",
        "thesis/logger": "0.1.x-dev",
        "thesis/net": "0.1.x-dev",
        "thesis/phpstan-extension": "0.1.x-dev",
        "thesis/process": "0.1.x-dev",
        "thesis/source-location": "0.1.x-dev",
        "thesis/testo-plugin": "0.1.x-dev",
        "thesis/time": "0.4.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": [
                "packages/dispatcher/src/",
                "packages/exceptionally/src/",
                "packages/logger/src/"
            ],
            "Thesis\\Amqp\\": "packages/amqp/src/",
            "Thesis\\AsyncTrace\\": "packages/async-trace/src/",
            "Thesis\\Async\\": "packages/async/src/",
            "Thesis\\Cache\\": "packages/cache/src/",
            "Thesis\\Demo\\": "packages/demo/src/",
            "Thesis\\Formatter\\": "packages/formatter/src/",
            "Thesis\\HotReload\\": "packages/hot-reload/src/",
            "Thesis\\Http\\": "packages/http/src/",
            "Thesis\\Io\\": "packages/io/src/",
            "Thesis\\Net\\": "packages/net/src/",
            "Thesis\\PhpstanExtension\\": "packages/phpstan-extension/src/",
            "Thesis\\Process\\": "packages/process/src/",
            "Thesis\\SourceLocation\\": "packages/source-location/src/",
            "Thesis\\TestoPlugin\\": "packages/testo-plugin/src/",
            "Thesis\\Time\\": "packages/time/src/"
        },
        "files": [
            "packages/amqp/src/Internal/internal.php",
            "packages/async/src/Internal/internal.php",
            "packages/async/src/Trace/api.php",
            "packages/async/src/api.php",
            "packages/async/src/platform.php",
            "packages/exceptionally/src/api.php",
            "packages/formatter/src/Internal/internal.php",
            "packages/formatter/src/api.php",
            "packages/http/src/Internal/Http1/internal.php",
            "packages/http/src/Internal/internal.php",
            "packages/http/src/api.php",
            "packages/io/src/Internal/internal.php",
            "packages/io/src/api.php",
            "packages/net/src/Internal/internal.php",
            "packages/net/src/api.php",
            "packages/source-location/src/Internal/internal.php",
            "packages/source-location/src/api.php",
            "packages/time/src/Internal/internal.php",
            "packages/time/src/api.php",
            "packages/time/polyfill/load.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": [
                "packages/dispatcher/tests/",
                "packages/exceptionally/tests/",
                "packages/logger/tests/"
            ],
            "Thesis\\Amqp\\": "packages/amqp/tests/",
            "Thesis\\AsyncTrace\\": "packages/async-trace/tests/",
            "Thesis\\Async\\": "packages/async/tests/",
            "Thesis\\Async\\Benchmarks\\": "packages/async/benchmarks/",
            "Thesis\\Cache\\": "packages/cache/tests/",
            "Thesis\\Formatter\\": "packages/formatter/tests/",
            "Thesis\\HotReload\\": "packages/hot-reload/tests/",
            "Thesis\\Http\\": "packages/http/tests/",
            "Thesis\\Http\\Benchmarks\\": "packages/http/benchmarks/",
            "Thesis\\Io\\": "packages/io/tests/",
            "Thesis\\Monorepo\\": "tools/monorepo/src/",
            "Thesis\\Monorepo\\Tests\\": "tools/monorepo/tests/",
            "Thesis\\Net\\": "packages/net/tests/",
            "Thesis\\PhpCsFixer\\": "tools/php-cs-fixer/src/",
            "Thesis\\PhpCsFixer\\Tests\\": "tools/php-cs-fixer/tests/",
            "Thesis\\Process\\": "packages/process/tests/",
            "Thesis\\SourceLocation\\": "packages/source-location/tests/",
            "Thesis\\TestoPlugin\\": "packages/testo-plugin/tests/",
            "Thesis\\Time\\": "packages/time/tests/",
            "Thesis\\TraceRecorder\\": "tools/trace-recorder/src/",
            "Thesis\\TraceRecorder\\Tests\\": "tools/trace-recorder/tests/"
        },
        "files": [
            "packages/amqp/tests/helpers.php",
            "packages/amqp/codegen/generate.php",
            "packages/async/tests/helpers.php",
            "packages/async-trace/tests/helpers.php",
            "packages/cache/tests/helpers.php",
            "packages/exceptionally/tests/Exceptionally/helpers.php",
            "packages/http/tests/Internal/Http1/helpers.php",
            "packages/http/tests/helpers.php",
            "packages/io/tests/helpers.php",
            "packages/logger/tests/Logger/helpers.php",
            "packages/net/tests/helpers.php",
            "packages/process/tests/helpers.php",
            "packages/time/tests/helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "llm/skills": true
        }
    }
}
