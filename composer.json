{
    "name": "thesis/monorepo",
    "description": "Thesis: an asynchronous PHP ecosystem built on revolt/event-loop",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "ext-tokenizer": "*",
        "llm/skills": "^1.17",
        "savinmikhail/add_named_arguments_rector": "^0.1.27",
        "symfony/console": "^8.0",
        "symfony/var-dumper": "^8.0",
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Monorepo\\": "tools/monorepo/src/",
            "Thesis\\Monorepo\\Tests\\": "tools/monorepo/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "llm/skills": true
        },
        "sort-packages": true
    }
}
