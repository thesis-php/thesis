// Generated by bin/monorepo sync from skip of packages/*/package.php, do not edit.
{
    "source": {
        "directories": [
            "../packages"
        ],
        "excludes": [
            "tests",
            "skills"
        ]
    },
    "logs": {
        "text": "../var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "tmpDir": "../var",
    "testFramework": "testo",
    // Infection looks for the config of any test framework (testo.php) in phpUnit.configDir.
    "phpUnit": {
        "configDir": "..",
    },
    "minCoveredMsi": 99,
    "mutators": {
        "@default": true,
        "Coalesce": {
            "ignore": [
                // Without the table every event resolves its listeners again and gets the same ones: only slower, which
                // no test sees.
                "Thesis\\Dispatcher::dispatch",
            ],
        },
    },
}
