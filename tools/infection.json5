// A mutant that no test can tell from the code is skipped by an annotation above the code that it mutates,
// with the reason: `// @infection-ignore Coalesce` (agents/php.md).
{
    "source": {
        "directories": [
            "../packages"
        ],
        "excludes": [
            "tests",
            "skills"
        ]
    },
    "logs": {
        "text": "../var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "tmpDir": "../var",
    "testFramework": "testo",
    // Infection looks for the config of any test framework (testo.php) in phpUnit.configDir.
    "phpUnit": {
        "configDir": "..",
    },
    // A mutant is killed by a test or skipped with the reason, none is left to a percentage.
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,
    },
}
