{
    "source": {
        "directories": [
            "../packages"
        ],
        "excludes": [
            "tests",
            "skills"
        ]
    },
    "logs": {
        "text": "../var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "tmpDir": "../var",
    "testFramework": "testo",
    // Infection looks for the config of any test framework (testo.php) in phpUnit.configDir.
    "phpUnit": {
        "configDir": "..",
    },
    "minCoveredMsi": 99,
    "mutators": {
        "@default": true,
    },
}
