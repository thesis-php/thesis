{
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "testFramework": "testo",
    "tmpDir": "var",
    "timeout": 10,
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true,
        // The finally in start() is defensive: its catch (\Throwable) cannot throw today, so unwrapping it is
        // equivalent, but if it ever does, the counters must still go down, or join() hangs forever.
        "UnwrapFinally": {
            "ignore": ["Thesis\\Async\\Internal\\GroupImpl::start"],
        },
    },
}
