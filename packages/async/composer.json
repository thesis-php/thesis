{
    "name": "thesis/async",
    "description": "Thesis Async",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "revolt/event-loop": "^1.0.9"
    },
    "require-dev": {
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Async\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Async\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
