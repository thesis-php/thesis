{
    "name": "thesis/async",
    "description": "Structured concurrency for PHP fibers with its own event loop, task-tree cancellation and lazy initialization.",
    "keywords": [
        "php",
        "async",
        "fibers",
        "structured-concurrency",
        "cancellation",
        "event-loop",
        "lazy-initialization"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/async",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "php-64bit": "*",
        "thesis/dispatcher": "^0.4",
        "thesis/source-location": "^0.1",
        "thesis/time": "^0.4"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-posix": "*",
        "testo/assert": "^0.1.17",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/testo-plugin": "^0.1"
    },
    "suggest": {
        "ext-pcntl": "To use awaitSignal() and trapSignals()"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Async\\": "src/"
        },
        "files": [
            "src/Internal/internal.php",
            "src/Trace/api.php",
            "src/api.php",
            "src/platform.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Async\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
