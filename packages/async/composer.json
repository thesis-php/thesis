{
    "name": "thesis/async",
    "description": "Structured concurrency for PHP fibers: cancellation is a property of the task tree.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "php-64bit": "*",
        "revolt/event-loop": "^1.0.9",
        "thesis/time": "^2.0"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-posix": "*",
        "amphp/amp": "^3",
        "testo/assert": "^0.1.17",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/testo-plugin": "^2.0"
    },
    "conflict": {
        "amphp/amp": "<3"
    },
    "suggest": {
        "ext-pcntl": "To use awaitSignal() and trapSignals() with the default event loop driver (ext-ev and ext-uv handle signals too)"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Async\\": "src/"
        },
        "files": [
            "src/autoload.files.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Async\\": "tests/"
        },
        "files": [
            "tests/autoload.files.php"
        ]
    }
}
