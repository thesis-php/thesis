{
    "name": "thesis/amqp",
    "description": "AMQP 0.9.1 client for RabbitMQ: publisher confirms, consumers as iterators, reconnects.",
    "keywords": [
        "php",
        "async",
        "fibers",
        "amqp",
        "amqp-client",
        "rabbitmq",
        "message-queue"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/amqp",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "php-64bit": "*",
        "ext-filter": "*",
        "ext-uri": "*",
        "thesis/async": "^0.1",
        "thesis/io": "^0.1",
        "thesis/net": "^0.1",
        "thesis/time": "^0.4"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/testo-plugin": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Amqp\\": "src/"
        },
        "files": [
            "src/Internal/internal.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Amqp\\": "tests/"
        },
        "files": [
            "tests/helpers.php",
            "codegen/generate.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    }
}
