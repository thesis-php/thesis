{
    "name": "thesis/testo-plugin",
    "description": "Testo plugins for thesis packages: tests in the event loop of thesis/async, real or virtual time, PHP errors as failures.",
    "keywords": [
        "php",
        "async",
        "testing",
        "testo",
        "event-loop",
        "virtual-time",
        "error-handling"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/testo-plugin",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "internal/container": "^1.1",
        "testo/testo": "^0.10.29",
        "thesis/async": "^0.1"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "thesis/time": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\TestoPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\TestoPlugin\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
