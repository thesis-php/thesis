{
    "name": "thesis/time",
    "description": "Time\\Duration polyfill for PHP >=8.2, shorthands like sec(5) and toMs(), PSR-20 clocks.",
    "keywords": [
        "php",
        "time",
        "duration",
        "clock",
        "psr-20",
        "polyfill"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/time",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.2.2",
        "psr/clock": "^1.0",
        "symfony/polyfill-php84": "^1.34"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Time\\": "src/"
        },
        "files": [
            "src/Internal/internal.php",
            "src/api.php",
            "polyfill/load.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Time\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
