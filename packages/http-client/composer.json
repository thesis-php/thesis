{
    "name": "thesis/http-client",
    "description": "Asynchronous HTTP/1 client with pooled HTTP and HTTPS connections, proxy tunnels, middleware, redirects, retries, streaming decompression and multipart uploads.",
    "keywords": [
        "php",
        "async",
        "http",
        "http1",
        "http-client",
        "streaming",
        "redirects",
        "retries",
        "middleware",
        "gzip",
        "multipart",
        "proxy",
        "keep-alive",
        "tcp",
        "tls"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/http-client",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "ext-zlib": "*",
        "thesis/async": "^0.1",
        "thesis/http": "^0.1",
        "thesis/http-protocol": "^0.1",
        "thesis/io": "^0.1",
        "thesis/net": "^0.1"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/testo-plugin": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\HttpClient\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
