{
    "name": "thesis/http",
    "description": "HTTP messages shared by clients and servers: requests with query parameters, responses, headers, and streamed bodies with trailers.",
    "keywords": [
        "php",
        "async",
        "http",
        "http-message",
        "http-headers",
        "query-string",
        "http-trailers"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/http",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "thesis/io": "^0.1"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Http\\": "src/"
        },
        "files": [
            "src/api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Http\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
