{
    "name": "thesis/http",
    "description": "Asynchronous HTTP/1 client and server with strict parsing, pooled connections, TLS, middleware and streamed bodies with trailers.",
    "keywords": [
        "php",
        "async",
        "http",
        "http1",
        "http-client",
        "http-server",
        "streaming",
        "tls",
        "http-message",
        "http-headers",
        "query-string",
        "http-trailers"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/http",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "php-64bit": "*",
        "ext-zlib": "*",
        "thesis/async": "^0.1",
        "thesis/io": "^0.1",
        "thesis/net": "^0.1",
        "thesis/time": "^0.4"
    },
    "require-dev": {
        "ext-openssl": "*",
        "amphp/http-client": "^5.3",
        "amphp/http-server": "^3.4",
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/testo-plugin": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Http\\": "src/"
        },
        "files": [
            "src/Internal/Http1/internal.php",
            "src/Internal/internal.php",
            "src/api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Http\\": "tests/"
        },
        "files": [
            "tests/Internal/Http1/helpers.php",
            "tests/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
