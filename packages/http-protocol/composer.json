{
    "name": "thesis/http-protocol",
    "description": "HTTP wire protocols for clients and servers, with a strict HTTP/1 codec for heads, bodies and trailers.",
    "keywords": [
        "php",
        "http",
        "http-protocol",
        "http1",
        "http-parser",
        "chunked-encoding",
        "http-trailers",
        "request-smuggling"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/http-protocol",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "php-64bit": "*",
        "thesis/http": "^0.1",
        "thesis/io": "^0.1"
    },
    "require-dev": {
        "amphp/http-client": "^5.3",
        "amphp/http-server": "^3.4",
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\HttpProtocol\\": "src/"
        },
        "files": [
            "src/Http1/api.php",
            "src/Internal/Http1/internal.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\HttpProtocol\\": "tests/"
        },
        "files": [
            "tests/Http1/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
