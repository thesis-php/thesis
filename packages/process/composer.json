{
    "name": "thesis/process",
    "description": "Group-owned Unix worker processes with signal handling and inherited IPC descriptors.",
    "keywords": [
        "php",
        "async",
        "fibers",
        "process",
        "subprocess",
        "workers",
        "ipc",
        "unix"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/process",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.6",
        "ext-pcntl": "*",
        "thesis/async": "^0.1",
        "thesis/exceptionally": "^0.4",
        "thesis/io": "^0.1"
    },
    "require-dev": {
        "amphp/process": "^2.1",
        "symfony/process": "^8.1",
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/dispatcher": "^0.4",
        "thesis/time": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        },
        "files": [
            "tests/Process/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
