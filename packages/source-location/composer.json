{
    "name": "thesis/source-location",
    "description": "Where in the source code: a file and a line, the caller outside a library, the code of eval() resolved.",
    "keywords": [
        "php",
        "source-location",
        "backtrace",
        "debugging"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.6",
        "composer-runtime-api": "^2.1"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\SourceLocation\\": "src/"
        },
        "files": [
            "src/Internal/internal.php",
            "src/api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\SourceLocation\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
