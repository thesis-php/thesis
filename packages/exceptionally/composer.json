{
    "name": "thesis/exceptionally",
    "description": "Turns PHP errors into exceptions around a callable, safe when the callable suspends a fiber.",
    "keywords": [
        "php",
        "error-handling",
        "exceptions",
        "warnings",
        "fibers"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/thesis-php/thesis/issues",
        "source": "https://github.com/thesis-php/thesis/tree/main/packages/exceptionally",
        "security": "https://github.com/thesis-php/thesis/security/policy"
    },
    "require": {
        "php": "^8.2.2",
        "symfony/polyfill-php85": "^1.32"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        },
        "files": [
            "src/api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        },
        "files": [
            "tests/Exceptionally/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
