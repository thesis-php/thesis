{
    "name": "thesis/io",
    "description": "Fast binary I/O: byte buffer with typed encoding, non-blocking streams and stdio.",
    "keywords": [
        "php",
        "async",
        "fibers",
        "io",
        "non-blocking-io",
        "streams",
        "buffer",
        "binary"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.6",
        "php-64bit": "*",
        "thesis/async": "^0.1",
        "thesis/time": "^0.4"
    },
    "require-dev": {
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/lifecycle": "^0.1.9",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29",
        "thesis/testo-plugin": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Io\\": "src/"
        },
        "files": [
            "src/Internal/internal.php",
            "src/api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Io\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
