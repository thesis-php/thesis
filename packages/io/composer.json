{
    "name": "thesis/io",
    "description": "Thesis Io",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Io\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Io\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
