{
    "name": "thesis/net",
    "description": "Non-blocking TCP and Unix sockets with TLS and an async DNS resolver, cancelled by the task tree.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "php-64bit": "*",
        "ext-filter": "*",
        "ext-openssl": "*",
        "thesis/async": "^0.1",
        "thesis/io": "^0.1",
        "thesis/time": "^0.1"
    },
    "require-dev": {
        "ext-intl": "*",
        "ext-sockets": "*",
        "revolt/event-loop": "^1.0.9",
        "testo/assert": "^0.1.17",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.29"
    },
    "suggest": {
        "ext-intl": "To resolve internationalized host names (Пример.test)",
        "ext-sockets": "To report why a connection failed (refused, unreachable) instead of a generic message"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Net\\": "src/"
        },
        "files": [
            "src/Internal/internal.php",
            "src/api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Net\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
