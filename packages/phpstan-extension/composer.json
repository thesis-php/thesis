{
    "name": "thesis/phpstan-extension",
    "description": "PHPStan extension for thesis packages: precise types where PHPDoc generics cannot express them, checks of what PHP cannot.",
    "license": "MIT",
    "type": "phpstan-extension",
    "authors": [
        {
            "name": "Vadim Zanfir",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/thesis-php/thesis/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "php-64bit": "*",
        "phpstan/phpstan": "^2.3"
    },
    "require-dev": {
        "thesis/async": "^0.1",
        "thesis/dispatcher": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\PhpstanExtension\\": "src/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
