services:
    -
        class: Thesis\PhpstanExtension\Internal\AllReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
    -
        class: Thesis\PhpstanExtension\Internal\AllSettledReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
    -
        class: Thesis\PhpstanExtension\Internal\MapReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
    -
        class: Thesis\PhpstanExtension\Internal\WeakMapConstantType
        arguments:
            parser: @cachedRichParser
        tags: [phpstan.broker.expressionTypeResolverExtension]
