includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - packages/phpstan-extension/extension.neon

parameters:
    level: max
    paths:
        - bin/monorepo
        - .php-cs-fixer.php
        - composer-dependency-analyser.php
        - monorepo.php
        - rector.php
        - tally.php
        - testo.php
        - testo-alone.php
        - tools
        - packages
    tmpDir: var/phpstan
    editorUrl: ''
    editorUrlTitle: '%%relFile%%:%%line%%'

    # strict rules
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    rememberPossiblyImpureFunctionValues: false
    reportAlwaysTrueInLastCondition: false
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true

services:
    -
        class: Thesis\PhpStanRules\PackageApiRule
        arguments:
            packagesDirectory: packages
        tags: [phpstan.rules.rule]
    -
        class: Thesis\PhpStanRules\PackageApiRule
        arguments:
            packagesDirectory: tools/phpstan/fixtures/packages
        tags: [phpstan.rules.rule]
    -
        class: Thesis\PhpStanRules\AsyncClockRule
        arguments:
            sourceDirectory: packages/async/src
        tags: [phpstan.rules.rule]
    -
        class: Thesis\PhpStanRules\AsyncClockRule
        arguments:
            sourceDirectory: tools/phpstan/fixtures/packages/async/src
        tags: [phpstan.rules.rule]
    -
        class: Thesis\PhpStanRules\WeakMapConstantType
        arguments:
            parser: @cachedRichParser
        tags: [phpstan.broker.expressionTypeResolverExtension]
